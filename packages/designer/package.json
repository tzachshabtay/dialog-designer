{
  "name": "@dialog-designer/designer",
  "version": "0.1.0",
  "description": "Engine-neutral in-game branching dialog designer DOM overlay.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzachshabtay/dialog-designer.git",
    "directory": "packages/designer"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
