{
  "name": "@dialog-designer/phaser",
  "version": "0.1.0",
  "description": "Phaser adapter for dialog-designer without imposing playback UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzachshabtay/dialog-designer.git",
    "directory": "packages/phaser"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dialog-designer/core": "0.1.0",
    "@dialog-designer/designer": "0.1.0"
  },
  "peerDependencies": {
    "@ai-game-assets/core": "^0.8.2",
    "@ai-game-assets/phaser": "^0.8.2",
    "phaser": ">=4"
  },
  "devDependencies": {
    "phaser": "^4.2.0"
  }
}
