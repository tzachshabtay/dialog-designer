{
  "name": "dialog-designer",
  "private": true,
  "version": "0.1.0",
  "description": "Branching dialog authoring and runtime tooling for TypeScript games.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/*",
    "demos/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "tsc -b packages/core packages/designer packages/dev packages/phaser --force",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
