{
  "name": "dialog-designer-detective-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/write-noir-score.mjs && node scripts/write-assets-module.mjs && node scripts/write-dialogs-module.mjs",
    "test": "npm run generate && node scripts/verify-demo.mjs",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "dev:server": "npm run generate && node dev-server.mjs",
    "build": "npm run generate && vite build",
    "build:pages": "npm run generate && vite build --base=./",
    "typecheck": "npm run generate && tsc --noEmit"
  },
  "dependencies": {
    "@ai-game-assets/core": "^0.8.4",
    "@ai-game-assets/dev": "^0.8.4",
    "@ai-game-assets/phaser": "^0.8.4",
    "@dialog-designer/core": "0.1.0",
    "@dialog-designer/dev": "0.1.0",
    "@dialog-designer/phaser": "0.1.0",
    "phaser": "^4.2.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "typescript": "^5.8.0"
  }
}
